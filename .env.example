# Docker 镜像必须固定到明确版本，生产复现可进一步填写 digest。
CUDA_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
MYLEETGPU_CUDA_ARCH=auto
MYLEETGPU_DATA_DIR=data
MYLEETGPU_PROBLEMS_DIR=problems
MYLEETGPU_HOST_DATA_DIR=
MYLEETGPU_HOST_UID=1000
MYLEETGPU_HOST_GID=1000
MYLEETGPU_DOCKER_GID=1000
MYLEETGPU_LOG_LEVEL=INFO
MYLEETGPU_JOB_POLL_SECONDS=0.25
MYLEETGPU_OUTPUT_LIMIT_BYTES=65536
MYLEETGPU_CONTAINER_MEMORY=2g
MYLEETGPU_CONTAINER_CPUS=2
MYLEETGPU_ALLOW_UNSAFE_HOST_RUNNER=false
