# Docker 镜像必须固定到明确版本，生产复现可进一步填写 digest。
CUDA_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
# 独立的 Triton/PyTorch 运行镜像，固定到已审计的 linux/amd64 digest。
TRITON_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel@sha256:14611869895df612b7b07227d5925f30ec3cd6673bad58ce3d84ed107950e014
MYLEETGPU_CUDA_ARCH=auto
MYLEETGPU_DATA_DIR=data
MYLEETGPU_PROBLEMS_DIR=problems
MYLEETGPU_HOST_DATA_DIR=
MYLEETGPU_HOST_UID=1000
MYLEETGPU_HOST_GID=1000
MYLEETGPU_DOCKER_GID=1000
MYLEETGPU_LOG_LEVEL=INFO
MYLEETGPU_JOB_POLL_SECONDS=0.25
MYLEETGPU_OUTPUT_LIMIT_BYTES=65536
MYLEETGPU_CONTAINER_MEMORY=2g
MYLEETGPU_CONTAINER_CPUS=2
MYLEETGPU_ALLOW_UNSAFE_HOST_RUNNER=false

# 普通 CPU C++17/Python 题使用可信本机原生进程，不需要 GPU/Docker。
# 可填写系统 C++ 编译器的名称或绝对路径；不是 shell 命令。
MYLEETGPU_CXX_BIN=c++

# Colab uses an EXISTING SSH-capable session. No runtime is created or stopped.
# Run API/Worker natively as the user who configured this CLI and SSH alias.
# These are server-controlled values; the web page never accepts keys or commands.
MYLEETGPU_COLAB_SSH_HOST=colab-vscode
MYLEETGPU_COLAB_SESSION=vscode-colab
MYLEETGPU_COLAB_CLI_BIN=colab
MYLEETGPU_COLAB_SSH_BIN=ssh
MYLEETGPU_COLAB_PYTHON_BIN=python3
MYLEETGPU_COLAB_REMOTE_ROOT=/content/project/myleetgpu-runner
MYLEETGPU_COLAB_CONNECT_TIMEOUT_SECONDS=20
MYLEETGPU_EXECUTION_PROBE_TIMEOUT_SECONDS=180

# 可选的认证局域网模式；默认 make start 仍只监听 127.0.0.1。
# 留空时 make start-lan 自动检测当前 WSL mirrored 网络的主要 IPv4。
MYLEETGPU_LAN_ADDRESS=
MYLEETGPU_LAN_PORT=3000
MYLEETGPU_LAN_USERNAME=myleetgpu
# 不要把 MYLEETGPU_LAN_PASSWORD 写进已提交文件；首次启动会生成随机密码。
